[
  {
    "name": "vera_workflow_stamp",
    "description": "Stamp the exact retained model_data_receipt_request.json through ordinary HTTPS for a run owned by this local reporter. Supply its original run_id and receipt_request, never report contents, paths or credentials. Save the exact returned receipt beside the request, then use workflow_usage.py stamp-report and deliver its queued receipt event. Stamping does not link the receipt or prove task completion. Browser-owned runs use the browser workflow-stamp operation.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "receipt_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunReceiptStampRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ConnectionEnvelope",
      "type": "object",
      "required": [
        "receipt_request",
        "run_id"
      ],
      "$defs": {
        "RunReceiptStampRequest": {
          "additionalProperties": false,
          "description": "The complete field allow-list accepted from a Vera run.",
          "properties": {
            "schema_version": {
              "default": 1,
              "enum": [
                1,
                2,
                3
              ],
              "title": "Schema Version",
              "type": "integer"
            },
            "product": {
              "anyOf": [
                {
                  "enum": [
                    "vera",
                    "clara",
                    "lucia"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Product"
            },
            "receipt_id": {
              "format": "uuid",
              "title": "Receipt Id",
              "type": "string"
            },
            "plugin_version": {
              "maxLength": 64,
              "minLength": 5,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
              "title": "Plugin Version",
              "type": "string"
            },
            "report_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Report Sha256",
              "type": "string"
            },
            "user_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "User Id"
            },
            "archive_run_id": {
              "anyOf": [
                {
                  "pattern": "^run_[0-9a-f]{24}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Archive Run Id"
            },
            "report_revision": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Report Revision"
            }
          },
          "required": [
            "receipt_id",
            "plugin_version",
            "report_sha256"
          ],
          "title": "RunReceiptStampRequest",
          "type": "object"
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vera_incident_register",
    "description": "Register or inspect this installed product's retained local reporting identity through ordinary HTTPS. Pass no arguments. Private credentials stay in the reporter; this does not claim a browser-owned task.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "title": "ConnectionEnvelope",
      "type": "object",
      "required": []
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vera_incident_report",
    "description": "Automatically record an observed Vera/setup/host execution failure, with all available relevant technical evidence. No extra confirmation or feature-request form. Use a stable random report UUID for retries. For reviewed diagnostics retained after a helper failure, set evidence_for_report_id to its original report UUID; this attaches the full technical chain without creating another failure episode. Never include professional/client outputs.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/Report"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ConnectionEnvelope",
      "type": "object",
      "required": [
        "report"
      ],
      "$defs": {
        "Diagnostic": {
          "additionalProperties": false,
          "properties": {
            "component": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Component",
              "type": "string"
            },
            "error_type": {
              "maxLength": 150,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Error Type",
              "type": "string"
            },
            "error_code": {
              "anyOf": [
                {
                  "maxLength": 150,
                  "pattern": "^[A-Za-z0-9_.: -]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Error Code"
            },
            "errno": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Errno"
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Exit Code"
            },
            "message": {
              "maxLength": 65536,
              "minLength": 1,
              "title": "Message",
              "type": "string"
            },
            "stage": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Stage",
              "type": "string"
            },
            "evidence_source": {
              "enum": [
                "observed-tool-result",
                "runtime-exception",
                "technical-log"
              ],
              "title": "Evidence Source",
              "type": "string"
            },
            "technical_frames": {
              "items": {
                "$ref": "#/$defs/TechnicalFrame"
              },
              "maxItems": 100,
              "title": "Technical Frames",
              "type": "array"
            },
            "technical_facts": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "maxProperties": 100,
              "title": "Technical Facts",
              "type": "object"
            }
          },
          "required": [
            "component",
            "error_type",
            "message",
            "stage",
            "evidence_source"
          ],
          "title": "Diagnostic",
          "type": "object"
        },
        "Report": {
          "additionalProperties": false,
          "properties": {
            "evidence_for_report_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Evidence For Report Id"
            },
            "response_to_remedy_revision": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Response To Remedy Revision"
            },
            "report_id": {
              "format": "uuid",
              "title": "Report Id",
              "type": "string"
            },
            "product": {
              "default": "vera",
              "enum": [
                "vera",
                "clara",
                "lucia"
              ],
              "title": "Product",
              "type": "string"
            },
            "product_version": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.+-]+$",
              "title": "Product Version",
              "type": "string"
            },
            "host": {
              "enum": [
                "codex",
                "cowork",
                "unknown"
              ],
              "title": "Host",
              "type": "string"
            },
            "platform": {
              "enum": [
                "macos",
                "windows",
                "linux",
                "unknown"
              ],
              "title": "Platform",
              "type": "string"
            },
            "host_version": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_. +()-]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Host Version"
            },
            "runtime_version": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_. +()-]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Runtime Version"
            },
            "worker_runtime_version": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_. +()-]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Worker Runtime Version"
            },
            "worker_platform": {
              "anyOf": [
                {
                  "enum": [
                    "macos",
                    "windows",
                    "linux",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Worker Platform"
            },
            "workflow": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Workflow",
              "type": "string"
            },
            "stage": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Stage",
              "type": "string"
            },
            "diagnostics": {
              "items": {
                "$ref": "#/$defs/Diagnostic"
              },
              "maxItems": 512,
              "minItems": 1,
              "title": "Diagnostics",
              "type": "array"
            },
            "measurements": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "maxProperties": 100,
              "title": "Measurements",
              "type": "object"
            },
            "unavailable": {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "title": "Unavailable",
              "type": "array"
            },
            "capture_state": {
              "default": "legacy",
              "description": "Use complete only with an observed error_code or technical_frames in at least one diagnostic. errno, exit_code and prose alone do not satisfy complete capture; otherwise retain pending or unavailable and explain the missing evidence.",
              "enum": [
                "legacy",
                "pending",
                "complete",
                "unavailable"
              ],
              "title": "Capture State",
              "type": "string"
            },
            "session_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Session Id"
            },
            "operation_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Operation Id"
            },
            "input_binding": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Input Binding"
            }
          },
          "required": [
            "report_id",
            "product_version",
            "host",
            "platform",
            "workflow",
            "stage",
            "diagnostics"
          ],
          "title": "Report",
          "type": "object"
        },
        "TechnicalFrame": {
          "additionalProperties": false,
          "description": "Package-relative source coordinates; never locals, arguments or case text.",
          "properties": {
            "file": {
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9_./-]+$",
              "title": "File",
              "type": "string"
            },
            "line": {
              "minimum": 1,
              "title": "Line",
              "type": "integer"
            },
            "function": {
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_.<>]+$",
              "title": "Function",
              "type": "string"
            }
          },
          "required": [
            "file",
            "line",
            "function"
          ],
          "title": "TechnicalFrame",
          "type": "object"
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vera_incident_status",
    "description": "Get targeted diagnostic requests, original-task resume instructions, required updates and recovery status. Answer technical requests automatically through supplemental reports tied to the exact request revision; then check for the recovery agent's reply. Remain linked to unresolved incidents.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "title": "ConnectionEnvelope",
      "type": "object",
      "required": []
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
