  {
    "name": "vera_incident_progress",
    "description": "Record observed remedy application or original-operation retry against its exact report and current revision. Progress never closes the original incident.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryEvent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ConnectionEnvelope",
      "type": "object",
      "required": [
        "progress"
      ],
      "$defs": {
        "RecoveryEvent": {
          "additionalProperties": false,
          "description": "An observed step for one original report and applicable remedy revision.",
          "properties": {
            "event_id": {
              "format": "uuid",
              "title": "Event Id",
              "type": "string"
            },
            "incident_id": {
              "format": "uuid",
              "title": "Incident Id",
              "type": "string"
            },
            "report_id": {
              "format": "uuid",
              "title": "Report Id",
              "type": "string"
            },
            "remedy_revision": {
              "minimum": 1,
              "title": "Remedy Revision",
              "type": "integer"
            },
            "kind": {
              "enum": [
                "remedy-received",
                "remedy-applied",
                "retry-started",
                "retry-failed",
                "retry-succeeded",
                "capture-unavailable"
              ],
              "title": "Kind",
              "type": "string"
            },
            "operation_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Operation Id"
            }
          },
          "required": [
            "event_id",
            "incident_id",
            "report_id",
            "remedy_revision",
            "kind"
          ],
          "title": "RecoveryEvent",
          "type": "object"
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
