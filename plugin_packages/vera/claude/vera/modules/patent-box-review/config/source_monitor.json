{
  "schema_version": "1.0",
  "enabled": false,
  "schedule": null,
  "owner": null,
  "proposed_cadence": "weekly and before case opening/finalization; configuration proposal only",
  "preflight_at": [
    "OPEN_CASE",
    "CALCULATE",
    "FINAL_REVIEW"
  ],
  "max_age_days_policy": 7,
  "policy_is_statutory_deadline": false,
  "scopes": [
    {
      "authority": "Normattiva/Gazzetta Ufficiale",
      "topic": "Art.6 D.L.146/2021 e modifiche"
    },
    {
      "authority": "Agenzia delle Entrate",
      "topic": "Provvedimenti, circolari, risoluzioni, risposte e istruzioni dichiarative"
    },
    {
      "authority": "MEF/MIMIT/UIBM",
      "topic": "Attività e proprietà industriale pertinenti"
    },
    {
      "authority": "Cassazione e giustizia tributaria",
      "topic": "Giurisprudenza con testo integrale e distinzione vecchio/nuovo regime"
    },
    {
      "authority": "Corti UE e proprietà intellettuale",
      "topic": "Decisioni rilevanti per tutela e diritti"
    }
  ],
  "discovery_queries": [
    "\"Patent Box\" \"articolo 6\" \"146\"",
    "\"Patent Box\" \"110\" circolare risoluzione interpello",
    "\"Patent Box\" software SIAE",
    "\"Patent Box\" credito ricerca sviluppo nettizzazione"
  ],
  "discovery_adapter": "TO_IMPLEMENT_IN_AUTHORIZED_HOST",
  "snapshot_input_schema": "source-snapshot.schema.json",
  "implemented": [
    "offline snapshot comparison",
    "case impact review queue"
  ],
  "not_implemented": [
    "live source discovery",
    "authenticated database access",
    "scheduler",
    "notification delivery",
    "source activation"
  ],
  "network_error_policy": "PARTIAL_SCAN; retain last valid snapshot, expose failed scope; never report no updates",
  "activation_policy": "human source and applicability review, new immutable ruleset version, regression tests, explicit case re-review",
  "no_silent_mutations": true
}
