                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                  },
                  "uniqueItems": true,
                  "maxItems": 10000
