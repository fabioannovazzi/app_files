{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vera:patent-box:casebook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxpayer",
    "objective",
    "facts",
    "projects",
    "activities",
    "ip_details",
    "applicability",
    "missing_documents",
    "template",
    "paragraphs",
    "incentives",
    "declarations",
    "adversarial_review",
    "office_requests"
