                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "group_relationship": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "activity_location": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "technical_direction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "risk": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "result_rights": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "fact_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                  },
                  "uniqueItems": true,
                  "maxItems": 10000
                }
              }
            },
            "minItems": 0,
            "maxItems": 10000
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch",
          "scope",
          "applicable",
          "reason",
          "evidence_ids",
          "source_ids"
        ],
        "properties": {
          "branch": {
            "type": "string",
            "enum": [
              "OUTSOURCING",
              "PREMIAL",
              "EXTRAORDINARY",
              "PENALTY",
              "INCENTIVES"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "missing_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "control_keys",
          "request",
          "reason",
          "owner",
          "consequence",
          "next_step",
          "priority"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
          },
          "control_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "next_step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "priority": {
            "type": "string",
            "enum": [
              "BEFORE_CALCULATION",
              "BEFORE_APPROVAL",
              "FOLLOW_UP"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "template": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "source_id",
            "evidence_id",
            "required_paragraphs",
            "simplifications"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "source_id": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "evidence_id": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "required_paragraphs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "paragraph_id",
                  "section",
                  "title"
                ],
                "properties": {
                  "paragraph_id": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                  },
                  "section": {
                    "type": "string",
                    "enum": [
                      "A",
                      "B"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                }
              },
              "minItems": 1,
              "maxItems": 10000
            },
            "simplifications": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "issue",
                  "conclusion",
                  "status",
                  "evidence_ids",
                  "source_ids"
                ],
                "properties": {
                  "issue": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                  },
                  "conclusion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "EVIDENCED",
                      "PROPOSED",
                      "UNRESOLVED"
                    ]
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                    },
                    "uniqueItems": true,
                    "maxItems": 10000
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                    },
                    "uniqueItems": true,
                    "maxItems": 10000
                  }
                }
              },
              "minItems": 0,
              "maxItems": 10000
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_id",
          "section",
          "title",
          "text",
          "status",
          "fact_ids",
          "source_ids"
        ],
        "properties": {
          "paragraph_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
          },
          "section": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "status": {
            "type": "string",
            "enum": [
              "EVIDENCED",
              "PROPOSED",
              "UNRESOLVED"
            ]
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "incentives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incentive_id",
          "allocation_ids",
          "period_id",
          "regime",
          "assessment",
          "conclusion",
          "evidence_ids",
          "source_ids",
          "inputs",
          "steps",
          "outputs",
          "action",
          "due_date",
          "deadline_source_ids",
          "deadline_reason"
        ],
        "properties": {
          "incentive_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
          },
          "allocation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "period_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
          },
          "regime": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "assessment": {
            "type": "string",
            "enum": [
              "NO_OVERLAP",
              "RECALCULATION",
              "UNRESOLVED"
            ]
          },
          "conclusion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "unit",
                "locator",
                "evidence_ids",
                "source_ids"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                },
                "value": {
                  "type": "string",
                  "pattern": "-?[0-9]{1,18}(\\.[0-9]{1,12})?"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "EUR",
                    "RATIO"
                  ]
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                  },
                  "uniqueItems": true,
                  "maxItems": 10000
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                  },
                  "uniqueItems": true,
                  "maxItems": 10000
                }
              }
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "operation",
                "operands"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "SUM",
                    "DIFFERENCE",
                    "PRODUCT",
                    "QUOTIENT",
                    "MIN",
                    "MAX"
                  ]
                },
                "operands": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                  },
                  "minItems": 2,
                  "maxItems": 10000
                }
              }
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "value_ref"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                },
                "value_ref": {
                  "type": "string",
                  "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
                }
              }
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "deadline_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "deadline_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_year",
          "period_id",
          "model_version",
