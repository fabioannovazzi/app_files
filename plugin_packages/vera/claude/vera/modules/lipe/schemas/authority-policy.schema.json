{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "lipe.authority.v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 2000
    },
    "studio_id": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 2000
    },
    "authority_name": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 2000
    },
    "data_origin": {
      "enum": [
        "REAL",
        "SYNTHETIC"
      ]
    },
    "admin_certificate_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "revoked_certificate_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "revoked_mandate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S",
        "maxLength": 2000
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "studio_id",
    "authority_name",
    "data_origin",
    "admin_certificate_sha256",
    "revoked_certificate_sha256",
    "revoked_mandate_ids"
  ]
}
