{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "pipeline": {
      "enum": [
        "LIPE"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1
    },
    "data_origin": {
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2024,
      "maximum": 2026
    },
    "quarter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "regime": {
      "enum": [
        "MONTHLY",
        "QUARTERLY_OPTION",
        "QUARTERLY_SPECIAL"
      ]
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "scope_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PROPOSED",
            "CONFIRMED"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "reason"
      ]
    },
    "unsupported_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "source_id",
          "path",
          "sha256"
        ]
      }
    },
    "opening": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credit": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
            },
            "small_debit": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "PROPOSED",
                    "CONFIRMED"
                  ]
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed_on": {
                  "type": "string",
                  "format": "date"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reviewer",
                "reviewed_on",
                "reason"
              ]
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "page",
                "quote"
              ]
            }
          },
          "required": [
            "credit",
            "small_debit",
            "review",
            "evidence"
          ]
        }
      ]
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "SALES",
              "PURCHASES",
              "INTEGRATION"
            ]
          },
          "treatment": {
            "enum": [
              "SALE_TAXABLE",
              "SALE_NO_OUTPUT_VAT",
              "SALE_EXCLUDED",
              "PURCHASE",
              "PURCHASE_REVERSE_CHARGE",
              "PURCHASE_EXCLUDED",
              "INTEGRATION_MIRROR"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "PROPOSED",
                  "CONFIRMED"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
          },
          "catalog_binding": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "revision_hashes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "tax_class_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "revision_hashes",
                  "tax_class_hash"
                ]
              }
            ]
          }
        },
        "required": [
          "code",
          "side",
          "treatment",
          "review",
          "catalog_binding"
        ]
      }
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "register_id": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "SALES",
              "PURCHASES",
              "INTEGRATION"
            ]
          },
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "number_format": {
            "enum": [
              "it-IT",
              "en-US"
            ]
          },
          "printed_base": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "printed_tax": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "page",
              "quote"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "PROPOSED",
                  "CONFIRMED"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "row_id": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "base": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                },
                "tax": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                },
                "deductible_tax": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                },
                "base_period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "tax_period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "deduction_period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source_id",
                    "page",
                    "quote"
                  ]
                },
                "review": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "PROPOSED",
                        "CONFIRMED"
                      ]
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reviewed_on": {
                      "type": "string",
                      "format": "date"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "reviewer",
                    "reviewed_on",
                    "reason"
                  ]
                },
                "mirror_of": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "row_id",
                "code",
                "base",
                "tax",
                "deductible_tax",
                "base_period",
                "tax_period",
                "deduction_period",
                "evidence",
                "review",
                "mirror_of"
              ]
            }
          }
        },
        "required": [
          "register_id",
          "side",
          "period",
          "number_format",
          "printed_base",
          "printed_tax",
          "evidence",
          "review",
          "rows"
        ]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "vp9": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp10": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp11": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp13": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp13_method": {
            "enum": [
              null,
              1,
              2,
              3,
              4
            ]
          },
          "credit_withheld": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "defer_small_debit": {
            "enum": [
              null,
              true,
              false
            ]
          },
          "principal_paid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "liquidation_vat": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reported output VAT less deductible VAT before prior-period credit, VP9–13 adjustments or interest; not the final amount payable."
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "PROPOSED",
                  "CONFIRMED"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "page",
              "quote"
            ]
          }
        },
        "required": [
          "period",
          "vp9",
          "vp10",
          "vp11",
          "vp13",
          "vp13_method",
          "credit_withheld",
          "defer_small_debit",
          "principal_paid",
          "liquidation_vat",
          "review",
          "evidence"
        ]
      }
    },
    "liquidations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "number_format": {
            "enum": [
              "it-IT",
              "en-US"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "page",
              "quote"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "PROPOSED",
                  "CONFIRMED"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "side": {
                  "enum": [
                    "SALES",
                    "PURCHASES",
                    "INTEGRATION"
                  ]
                },
                "base_basis": {
                  "enum": [
                    "REGISTRATION",
                    "CHARGEABILITY",
                    "DEDUCTION"
                  ]
                },
                "tax_basis": {
                  "enum": [
                    "RECORDED",
                    "OUTPUT",
                    "DEDUCTIBLE"
                  ]
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "base": {
                        "type": "string",
                        "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                      },
                      "tax": {
                        "type": "string",
                        "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                      },
                      "evidence": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "source_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "page": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "source_id",
                          "page",
                          "quote"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "base",
                      "tax",
                      "evidence"
                    ]
                  }
                }
              },
              "required": [
                "side",
                "base_basis",
                "tax_basis",
                "rows"
              ]
            }
          }
        },
        "required": [
          "period",
          "number_format",
          "evidence",
          "review",
          "sections"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "minItems": 0
    },
    "anomaly_review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/review"
        }
      ]
    },
    "correspondence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/correspondence"
        }
      ]
    },
    "catalog_context": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "catalog_id": {
              "type": "string",
              "pattern": "\\S"
            },
            "studio_id": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "catalog_id",
            "studio_id"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "pipeline",
    "case_id",
    "client_id",
    "engagement_id",
    "data_origin",
    "tax_year",
    "quarter",
    "regime",
    "software",
    "scope_review",
    "unsupported_features",
    "sources",
    "opening",
    "mappings",
    "registers",
    "modules",
    "liquidations",
    "observations",
    "anomaly_review",
    "correspondence",
    "catalog_context"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LIPE: reviewed evidence and exact arithmetic for one client and quarter",
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PROPOSED",
            "CONFIRMED"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "reason"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "page",
        "quote"
      ]
    },
    "observationBindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "engine_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "facts_hash",
        "observation_hash",
        "engine_hash",
        "rules_hash"
      ]
    },
    "observationDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "invoice_number": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "counterparty": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount_basis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "number_format": {
          "enum": [
            "it-IT",
            "en-US"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "protocol",
        "invoice_number",
        "date",
        "counterparty",
        "amount",
        "amount_basis",
        "number_format",
        "evidence"
      ]
    },
    "observationDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "enum": [
            "NO_CHANGE",
            "INPUTS_REVISED"
          ]
        },
        "bindings": {
          "$ref": "#/$defs/observationBindings"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "resolution",
        "bindings",
        "review"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "A1",
            "A2",
            "A3",
            "A4",
            "A5",
            "A6",
            "A7",
            "A8",
            "A9",
            "A10",
            "A11",
            "A12",
            "A13",
            "OTHER"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "row_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observationDocument"
          },
          "minItems": 0
        },
        "vp6_effect": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "period": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "period",
              "amount",
              "basis"
            ]
          },
          "minItems": 0
        },
        "proposed_action": {
          "type": "string",
          "minLength": 1
        },
        "related_comparisons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "decision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/observationDecision"
            }
          ]
        },
        "related_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "observation_id",
        "category",
        "title",
        "assessment",
        "periods",
        "row_ids",
        "evidence",
        "documents",
        "vp6_effect",
        "proposed_action",
        "related_comparisons",
        "decision",
        "related_findings"
      ]
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_label": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "filing_deadline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                },
                "review": {
                  "$ref": "#/$defs/review"
                }
              },
              "required": [
                "date",
                "evidence",
                "review"
              ]
            }
          ]
        }
      },
      "required": [
        "client_label",
        "recipient",
        "filing_deadline"
      ]
    }
  }
}
