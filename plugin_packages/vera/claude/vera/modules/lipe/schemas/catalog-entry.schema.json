{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LIPE local catalog entry with declared professional provenance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "lipe.catalog.entry.v1"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
    },
    "scope": {
      "enum": [
        "CLIENT",
        "STUDIO",
        "CENTRAL"
      ]
    },
    "client_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "side": {
      "enum": [
        "SALES",
        "PURCHASES",
        "INTEGRATION"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "tax_class": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "treatment": {
          "anyOf": [
            {
              "enum": [
                "SALE_TAXABLE",
                "SALE_NO_OUTPUT_VAT",
                "SALE_EXCLUDED",
                "PURCHASE",
                "PURCHASE_REVERSE_CHARGE",
                "PURCHASE_EXCLUDED",
                "INTEGRATION_MIRROR"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "vat_rate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9]|[1-9][0-9]|100)\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "vat_nature": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "deductibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "UNKNOWN",
                "CASE_SPECIFIC",
                "FULL",
                "PARTIAL",
                "NONE"
              ]
            },
            "percent": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9]|[1-9][0-9]|100)\\.[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "percent"
          ]
        },
        "mechanism": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "counterparty_regime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "legal_basis": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "treatment",
        "vat_rate",
        "vat_nature",
        "deductibility",
        "mechanism",
        "counterparty_regime",
        "legal_basis"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]{2}|1\\.00)$"
        },
        "basis": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "value",
        "basis"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "visibility": {
            "enum": [
              "PRIVATE_CASE",
              "STUDIO_REFERENCE",
              "PUBLIC"
            ]
          }
        },
        "required": [
          "source_id",
          "path",
          "sha256",
          "visibility"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "page",
          "quote"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PROPOSED",
            "CONFIRMED"
          ]
        },
        "reviewer": {
          "type": "string",
          "pattern": "\\S"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "reason"
      ]
    },
    "curator_review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "PROPOSED",
                "CONFIRMED"
              ]
            },
            "reviewer": {
              "type": "string",
              "pattern": "\\S"
            },
            "reviewed_on": {
              "type": "string",
              "format": "date"
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "reviewer",
            "reviewed_on",
            "reason"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "disclosure_review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "PROPOSED",
                "CONFIRMED"
              ]
            },
            "reviewer": {
              "type": "string",
              "pattern": "\\S"
            },
            "reviewed_on": {
              "type": "string",
              "format": "date"
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "reviewer",
            "reviewed_on",
            "reason"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "entry_id",
    "scope",
    "client_id",
    "software",
    "side",
    "code",
    "description",
    "tax_class",
    "confidence",
    "valid_from",
    "valid_until",
    "sources",
    "evidence",
    "review",
    "curator_review",
    "disclosure_review"
  ]
}
