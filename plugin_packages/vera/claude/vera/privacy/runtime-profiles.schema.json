{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mparanza.com/schemas/vera-runtime-profiles-v1.json",
  "title": "Vera model-runtime privacy profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "runtime",
          "surfaces",
          "account_boundary",
          "model_processing"
        ],
        "properties": {
          "id": {
            "enum": [
              "openai-codex",
              "anthropic-cowork"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "account_boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selected_by",
              "vera_runtime_enforcement",
              "review_timing",
              "review_items",
              "per_case_record_required"
            ],
            "properties": {
              "selected_by": {
                "const": "firm_or_user"
              },
              "vera_runtime_enforcement": {
                "const": "none"
              },
              "review_timing": {
                "const": "before_professional_use_and_when_account_or_terms_change"
              },
              "review_items": {
                "const": [
                  "account_or_workspace_plan",
                  "model_training_data_controls",
                  "retention_and_deletion_controls"
                ]
              },
              "per_case_record_required": {
                "const": false
              }
            }
          },
          "model_processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "destination",
              "account_arrangement",
              "separate_vera_recipient",
              "automatic_anonymization",
              "local_only",
              "local_filtering_or_aggregation"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "account_arrangement": {
                "type": "string",
                "minLength": 1
              },
              "separate_vera_recipient": {
                "const": false
              },
              "automatic_anonymization": {
                "const": false
              },
              "local_only": {
                "const": false
              },
              "local_filtering_or_aggregation": {
                "const": "only_when_useful_for_the_work"
              }
            }
          }
        }
      }
    }
  }
}
