                  },
                  "error_code": {
                    "anyOf": [
                      {
                        "maxLength": 150,
                        "pattern": "^[A-Za-z0-9_.: -]+$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Error Code"
                  },
                  "errno": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Errno"
                  },
                  "exit_code": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Exit Code"
                  },
                  "message": {
                    "maxLength": 65536,
                    "minLength": 1,
                    "title": "Message",
                    "type": "string"
                  },
                  "stage": {
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.:-]+$",
                    "title": "Stage",
                    "type": "string"
                  },
                  "evidence_source": {
                    "enum": [
                      "observed-tool-result",
                      "runtime-exception",
                      "technical-log"
                    ],
                    "title": "Evidence Source",
                    "type": "string"
                  },
                  "technical_frames": {
                    "items": {
                      "$ref": "#/$defs/TechnicalFrame"
                    },
                    "maxItems": 100,
                    "title": "Technical Frames",
                    "type": "array"
                  },
                  "technical_facts": {
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    },
                    "maxProperties": 100,
                    "title": "Technical Facts",
                    "type": "object"
                  }
                },
                "required": [
                  "component",
                  "error_type",
                  "message",
                  "stage",
                  "evidence_source"
                ],
                "title": "Diagnostic",
                "type": "object"
              },
              "Outcome": {
                "additionalProperties": false,
                "properties": {
                  "report_id": {
                    "anyOf": [
                      {
                        "format": "uuid",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Report Id"
                  },
                  "outcome_id": {
                    "format": "uuid",
                    "title": "Outcome Id",
                    "type": "string"
                  },
                  "incident_id": {
                    "format": "uuid",
                    "title": "Incident Id",
                    "type": "string"
                  },
                  "remedy_revision": {
                    "minimum": 1,
                    "title": "Remedy Revision",
                    "type": "integer"
                  },
                  "status": {
                    "enum": [
                      "recovered",
                      "failed",
                      "action-required"
                    ],
                    "title": "Status",
                    "type": "string"
                  },
                  "diagnostics": {
                    "items": {
                      "$ref": "#/$defs/Diagnostic"
                    },
                    "maxItems": 512,
                    "title": "Diagnostics",
                    "type": "array"
                  },
                  "execution_succeeded": {
                    "default": false,
                    "title": "Execution Succeeded",
                    "type": "boolean"
                  },
                  "operation_id": {
                    "anyOf": [
                      {
                        "format": "uuid",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Operation Id"
                  },
                  "input_binding": {
                    "anyOf": [
                      {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Input Binding"
                  },
                  "original_task_verified": {
                    "default": false,
                    "title": "Original Task Verified",
                    "type": "boolean"
                  }
                },
                "required": [
                  "outcome_id",
                  "incident_id",
                  "remedy_revision",
                  "status"
                ],
                "title": "Outcome",
                "type": "object"
              },
              "TechnicalFrame": {
                "additionalProperties": false,
                "description": "Package-relative source coordinates; never locals, arguments or case text.",
                "properties": {
                  "file": {
                    "maxLength": 250,
                    "pattern": "^[A-Za-z0-9_./-]+$",
                    "title": "File",
                    "type": "string"
                  },
                  "line": {
                    "minimum": 1,
                    "title": "Line",
                    "type": "integer"
                  },
                  "function": {
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_.<>]+$",
                    "title": "Function",
                    "type": "string"
                  }
                },
                "required": [
