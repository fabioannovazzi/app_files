{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mparanza.com/schemas/advisory-contract-1.0.json",
  "title": "Clara advisory contract",
  "type": "object",
  "required": [
    "schema_version",
    "decision",
    "purpose",
    "audience",
    "deliverable_type",
    "output_language",
    "scope_included",
    "scope_excluded",
    "available_inputs",
    "evidence_requirements",
    "analysis_plan",
    "assumptions",
    "unresolved_questions",
    "success_criteria",
    "selected_clara_workflow",
    "validation_profile",
    "validation_scope",
    "correction_policy",
    "professional_judgement_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "deliverable_type": {"type": "string", "minLength": 1},
    "output_language": {
      "type": "string",
      "enum": ["it", "en", "fr", "de", "es"]
    },
    "scope_included": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "scope_excluded": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "available_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "analysis_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "selected_clara_workflow": {"type": "string", "minLength": 1},
    "validation_profile": {
      "type": "object",
      "required": ["review_dimensions", "format_checks"],
      "properties": {
        "review_dimensions": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "contract_conformance",
              "factual_source_support",
              "calculations_data_provenance",
              "reasoning_assumptions",
              "contradictions_missing_evidence",
              "recommendation_evidence_decision_fit",
              "professional_judgement_boundaries",
              "correction_needs",
              "residual_uncertainty",
              "delivery_readiness"
            ]
          }
        },
        "format_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["workflow", "requirement", "reason", "artifact_refs"],
            "properties": {
              "workflow": {"type": "string", "minLength": 1},
              "requirement": {
                "enum": ["required", "if_applicable", "not_required"]
              },
              "reason": {"type": "string", "minLength": 1},
              "artifact_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "validation_scope": {
      "type": "object",
      "required": ["coverage", "included_sections", "excluded_sections", "limitations"],
      "properties": {
        "coverage": {
          "enum": ["all_material_content", "selected_material_content", "limited"]
        },
        "included_sections": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_sections": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "correction_policy": {
      "type": "object",
      "required": ["mode", "preserve_original", "allowed", "approval_required_before_delivery"],
      "properties": {
        "mode": {"const": "separate_artifact"},
        "preserve_original": {"const": true},
        "allowed": {"type": "boolean"},
        "approval_required_before_delivery": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "professional_judgement_policy": {
      "type": "object",
      "required": ["owner", "model_role", "approval_required_before_delivery"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "model_role": {"type": "string", "minLength": 1},
        "approval_required_before_delivery": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
