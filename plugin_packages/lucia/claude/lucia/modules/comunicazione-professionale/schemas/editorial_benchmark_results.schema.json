{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model",
    "assessment_template_version",
    "template_sha256",
    "assessor_session_id",
    "evaluated_at",
    "judgments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"type": "string", "minLength": 1, "maxLength": 200},
    "model": {"type": "string", "minLength": 1, "maxLength": 200},
    "assessment_template_version": {"const": "professional-communication-editorial-v4"},
    "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessor_session_id": {"type": "string", "minLength": 8, "maxLength": 200},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "verdict", "analysis"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^EQ-[0-9]{3}$"},
          "verdict": {"enum": ["ready", "revise", "no_publish"]},
          "analysis": {"type": "string", "minLength": 30, "maxLength": 3000}
        }
      }
    }
  }
}
