{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow",
    "workspace_id",
    "bound_path",
    "owner",
    "retention_owner",
    "authorized_by",
    "authorization_asserted_not_authenticated",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workflow": {"const": "comunicazione-professionale"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,79}$"},
    "bound_path": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "retention_owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "authorized_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "authorization_asserted_not_authenticated": {"const": true},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
