{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":"\\S"},
    "citation":{"type":"object","additionalProperties":false,"required":["source_id","anchor","quote"],"properties":{"source_id":{"$ref":"#/$defs/text"},"anchor":{"$ref":"#/$defs/text"},"quote":{"$ref":"#/$defs/text"}}},
    "judgment":{"type":"object","additionalProperties":false,"required":["status","reason"],"properties":{"status":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","language","scope","inventory","authorities","claims","limitations"],
  "properties":{
    "schema_version":{"const":1},
    "language":{"enum":["it","en","fr","de","es"]},
    "scope":{"$ref":"#/$defs/text"},
    "inventory":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","additionalProperties":false,"required":["reviewed_anchors","limitations"],"properties":{"reviewed_anchors":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"limitations":{"type":"array","items":{"$ref":"#/$defs/text"}}}}},
    "authorities":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "required":["id","citation","kind","url","source_id","access","checked_at","version","reviewed_anchors","limitations"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"citation":{"$ref":"#/$defs/text"},
        "kind":{"enum":["statute","decision","guidance","other"]},"url":{"type":"string"},
        "source_id":{"type":["string","null"]},"access":{"enum":["full-text","excerpt","unavailable"]},
        "checked_at":{"type":"string","format":"date"},"version":{"$ref":"#/$defs/text"},
        "reviewed_anchors":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "limitations":{"type":"array","items":{"$ref":"#/$defs/text"}}
      }
    }},
    "claims":{"type":"array","items":{
      "type":"object","additionalProperties":false,"required":["id","document_passage","proposition","relevant_date","checks","correction"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"document_passage":{"$ref":"#/$defs/citation"},
        "proposition":{"$ref":"#/$defs/text"},"relevant_date":{"$ref":"#/$defs/text"},"correction":{"$ref":"#/$defs/text"},
        "checks":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["authority_id","identity","version","support","passages","reasoning"],
          "properties":{
            "authority_id":{"$ref":"#/$defs/text"},
            "identity":{"enum":["matched","mismatch","unresolved"]},
            "version":{"enum":["applicable","wrong-version","unresolved"]},
            "support":{"enum":["supports","partial","contradicts","does-not-address","unresolved"]},
            "passages":{"type":"array","items":{"$ref":"#/$defs/citation"}},
            "reasoning":{"$ref":"#/$defs/text"}
          }
        }}
      }
    }},
    "limitations":{"type":"array","items":{"$ref":"#/$defs/text"}}
  }
}
