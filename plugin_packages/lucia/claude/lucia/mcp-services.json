{
  "mcpServers": {
    "luciaAssuranceRuntime": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/assurance_runtime_mcp.cjs"
      ]
    },
    "luciaDeepResearchValidator": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/review_engine_mcp.cjs",
        "deep-research-validator"
      ]
    },
    "luciaFirmMethod": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/method_mcp.cjs"
      ]
    },
    "luciaIncidentHost": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/incident_host_mcp.cjs"
      ]
    },
    "luciaMatterOpening": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/matter_mcp.cjs"
      ]
    },
    "luciaPromptOptimizer": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/review_engine_mcp.cjs",
        "prompt-optimizer"
      ]
    },
    "luciaStudioArchive": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run_component_mcp.cjs",
        "studio-archive"
      ],
      "env": {
        "LUCIA_ASSURANCE_HOST": "1"
      }
    }
  }
}
