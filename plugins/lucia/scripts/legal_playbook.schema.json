{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "derived_from", "name", "workflow", "language", "purpose", "columns", "questions", "firm_positions", "source_requirements", "template_name", "outputs", "tracked_changes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"},
    "version": {"type": "integer", "minimum": 1},
    "derived_from": {"oneOf": [
      {"type": "null"},
      {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"}, "version": {"type": "integer", "minimum": 1}
      }}
    ]},
    "name": {"type": "string", "minLength": 1, "maxLength": 300},
    "workflow": {"enum": ["revisione-contratti", "confronto-documenti", "revisione-documentale", "redazione-da-modello", "controllo-documento"]},
    "language": {"enum": ["it", "en", "fr", "de", "es"]},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 5000},
    "columns": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "questions": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "firm_positions": {"type": "string", "maxLength": 50000},
    "source_requirements": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "template_name": {"type": "string", "maxLength": 500},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["html", "xlsx", "docx"]}},
    "tracked_changes": {"type": "boolean"}
  }
}
