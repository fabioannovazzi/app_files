  "locales": {
    "it": {
      "title": "Actual e Budget: leggere importi e percentuali",
      "goal": "Interpretare un report di controllo di gestione a partire da periodo, segni e categorie rivedute.",
      "scenario": "Arco confronta gennaio e febbraio. I ricavi Actual sono 150.000 EUR contro 140.000 a Budget; i costi inclusi sono 60.000 contro 59.000. Non sono forniti scadenzari o previsioni per i mesi successivi.",
      "request": "Vera, mostrami dove il risultato si discosta dal Budget nei due mesi chiusi.",
      "scope": "Confronto del margine sulle categorie fornite. Le sezioni senza fonti restano indisponibili; il caso non inventa scadenzari, forecast o mesi futuri.",
      "input_columns": [
        "Voce · gennaio–febbraio",
        "Actual",
        "Budget"
      ],
      "input_rows": [
        [
          "Ricavi",
          "150.000 EUR",
          "140.000 EUR"
        ],
        [
          "Costi inclusi",
          "60.000 EUR",
          "59.000 EUR"
        ],
        [
          "Margine sulle voci incluse",
          "90.000 EUR",
          "81.000 EUR"
        ]
      ],
      "basis": "M1 e M2 rappresentano gli export sintetici dei medesimi due mesi completi. Le categorie e il segno dei costi sono riveduti prima del confronto.",
      "method": [
        "Ispeziona gli export e rivedi ruoli, colonne, categorie, segni, valuta, periodo e cutoff; conferma i totali di controllo.",
        "Esegui il pacchetto locale e leggi metriche e limiti. Mostra scostamento assoluto e percentuale; una base nulla o negativa non genera una percentuale fuorviante.",
        "Spiega i principali contributi distinguendo osservazioni e ipotesi. Le sezioni opzionali compaiono solo quando esistono dati sufficienti e il commento resta rivedibile."
      ],
      "result_title": "Margine superiore al Budget di 9.000 EUR",
      "conclusion": "I ricavi aggiungono 10.000 EUR; i maggiori costi ne assorbono 1.000. Il margine sulle voci fornite cresce da 81.000 a 90.000 EUR, pari a +11,11%.",
      "output_columns": [
        "Voce",
        "Δ EUR",
        "Δ % sulla base Budget"
      ],
      "output_rows": [
        [
          "Ricavi",
          "+10.000",
          "+7,14%"
        ],
        [
          "Costi",
          "+1.000",
          "+1,69% · sfavorevole"
        ],
        [
          "Margine",
          "+9.000",
          "+11,11%"
        ]
      ],
      "check": "Un aumento dei costi non diventa favorevole perché il segno è positivo. Prima di spiegare una causa commerciale, verifica che periodi e categorie siano confrontabili.",
      "question": "Se il Budget di una voce è zero, quale informazione manteniamo?",
      "answer": "Manteniamo lo scostamento in EUR e segnaliamo la percentuale come non disponibile. Non mostriamo infinito né una percentuale inventata.",
      "practice": "Aggiungi un mese completo a entrambi gli export e riesegui il confronto con il nuovo cutoff.",
      "next": "Seleziona contabilità e Budget coerenti. Aggiungi scadenzari o forecast solo quando fanno parte dell'incarico e sono disponibili."
    },
    "en": {
      "title": "Actual versus Budget: read amounts and percentages",
      "goal": "Interpret a management report using reviewed periods, signs and categories.",
      "scenario": "Fictional Arco compares January and February. Actual revenue is EUR 150,000 versus Budget 140,000; included costs are 60,000 versus 59,000. No open-item schedules or later-month forecasts are supplied.",
      "request": "Vera, show where the result differs from Budget in the two closed months.",
      "scope": "A margin comparison on supplied categories. Unsupported sections remain unavailable; no forecast, aging schedule or future months are invented.",
      "input_columns": [
        "January–February item",
        "Actual",
        "Budget"
      ],
      "input_rows": [
        [
          "Revenue",
          "EUR 150,000",
          "EUR 140,000"
        ],
        [
          "Included costs",
          "EUR 60,000",
          "EUR 59,000"
        ],
        [
          "Margin on included items",
          "EUR 90,000",
          "EUR 81,000"
        ]
      ],
      "basis": "M1 and M2 describe the same two complete months. Category meaning and cost signs are reviewed before comparison.",
      "method": [
        "Inspect exports and review roles, columns, categories, signs, currency, period and cutoff. Confirm control totals.",
        "Run the local pack and read metrics and limitations. Show absolute and percentage changes, withholding misleading percentages on zero or negative bases.",
        "Explain the main contributions while separating observations from hypotheses. Optional sections require adequate inputs and commentary remains reviewable."
      ],
      "result_title": "Margin exceeds Budget by EUR 9,000",
      "conclusion": "Extra revenue adds EUR 10,000 and higher costs absorb EUR 1,000. Margin rises from EUR 81,000 to EUR 90,000: +11.11%.",
      "output_columns": [
        "Item",
        "Δ EUR",
        "Δ % on Budget"
      ],
      "output_rows": [
        [
          "Revenue",
          "+10,000",
          "+7.14%"
        ],
        [
          "Costs",
          "+1,000",
          "+1.69% · unfavorable"
        ],
        [
          "Margin",
          "+9,000",
          "+11.11%"
        ]
      ],
      "check": "A positive cost change is not favorable. Check comparable periods and categories before explaining a commercial cause.",
      "question": "What do we retain when an item's Budget is zero?",
      "answer": "Retain the EUR difference and mark the percentage unavailable. Do not display infinity or an invented percentage.",
      "practice": "Add a complete month to both exports and rerun with the new cutoff.",
      "next": "Select coherent accounting and Budget exports. Add aging or forecast inputs when they belong to the assignment and are available."
    }
  },
