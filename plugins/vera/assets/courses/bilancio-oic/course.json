  "locales": {
    "it": {
      "title": "Dal prospetto contabile alla bozza di bilancio",
      "goal": "Capire come lettura dei saldi, mappatura e controlli accompagnano la preparazione di un bilancio OIC/XBRL da rivedere.",
      "scenario": "Arco consegna un prospetto con attività di 250.000 EUR, passività di 180.000 EUR e patrimonio netto di 70.000 EUR. La voce 'crediti diversi' comprende 8.000 EUR senza dettaglio. I numeri quadrano, ma la classificazione di quel saldo rimane da chiarire.",
      "request": "Vera, mostrami la mappatura e i punti da chiarire prima di produrre la bozza di bilancio.",
      "scope": "Microcaso di lettura e mappatura; non è un bilancio depositabile. Tassonomia, forma del bilancio, comparativi e note richiedono il normale percorso completo.",
      "input_columns": [
        "Voce del prospetto fittizio",
        "EUR",
        "Riferimento"
      ],
      "input_rows": [
        [
          "Attività totali",
          "250.000",
          "S1 · riga 10"
        ],
        [
          "Passività",
          "180.000",
          "S1 · riga 20"
        ],
        [
          "Patrimonio netto",
          "70.000",
          "S1 · riga 30"
        ],
        [
          "Crediti diversi, inclusi nelle attività",
          "8.000",
          "S1 · riga 7; dettaglio assente"
        ]
      ],
      "basis": "Il prospetto S1 supporta soltanto saldi e quadratura. Non spiega la natura degli 8.000 EUR, né fornisce comparativi o informazioni integrative.",
      "method": [
        "Conferma esercizio, forma del bilancio, principi e lingua; ispeziona le fonti e conserva i localizzatori di ogni saldo.",
        "Proponi la mappatura motivata. Raccogli chiarimenti sulle voci ambigue e lascia visibili le decisioni da rivedere.",
        "Esegui controlli e generazione solo con il contratto e la tassonomia correnti. Presenta bozze e diagnostica con lo stato di revisione, senza dichiarare un deposito."
      ],
      "result_title": "Quadratura presente, classificazione aperta",
      "conclusion": "250.000 − 180.000 − 70.000 = 0 EUR. La quadratura non risolve la natura dei crediti diversi.",
      "output_columns": [
        "Controllo",
        "Risultato",
        "Conseguenza"
      ],
      "output_rows": [
        [
          "Equilibrio patrimoniale",
          "0 EUR di differenza",
          "Controllo aritmetico soddisfatto"
        ],
        [
          "Crediti diversi · 8.000 EUR",
          "Natura non documentata",
          "Richiedere dettaglio prima della mappatura definitiva"
        ],
        [
          "Comparativi e note",
          "Non forniti nel microcaso",
          "Perimetro incompleto"
        ]
      ],
      "check": "Una quadratura numerica non certifica classificazione, completezza o conformità. L'istanza e le bozze conservano i propri limiti e la revisione professionale.",
      "question": "Possiamo assegnare tutti i crediti diversi a una voce solo per chiudere la mappatura?",
      "answer": "No. La natura del credito deve essere sostenuta dal dettaglio. Il punto resta aperto e il professionista rivede la proposta.",
      "practice": "Aggiungi il dettaglio degli 8.000 EUR e rivedi la mappatura senza cambiare i totali.",
      "next": "Nel tuo fascicolo prepara prospetti completi, comparativi e documenti integrativi; indica esercizio e forma del bilancio."
    },
    "en": {
      "title": "From accounting balances to a draft financial statement",
      "goal": "Understand how source reading, mapping and checks support a reviewable OIC statement and XBRL output.",
      "scenario": "Fictional Arco supplies assets of EUR 250,000, liabilities of EUR 180,000 and equity of EUR 70,000. Other receivables include EUR 8,000 without detail. The totals balance, but that classification remains unresolved.",
      "request": "Vera, show the mapping and questions to resolve before preparing the draft statement.",
      "scope": "A small reading and mapping case, not a filing-ready statement. Taxonomy, statement form, comparatives and notes need the complete normal workflow.",
      "input_columns": [
        "Fictional statement item",
        "EUR",
        "Reference"
      ],
      "input_rows": [
        [
          "Total assets",
          "250,000",
          "S1 · row 10"
        ],
        [
          "Liabilities",
          "180,000",
          "S1 · row 20"
        ],
        [
          "Equity",
          "70,000",
          "S1 · row 30"
        ],
        [
          "Other receivables within assets",
          "8,000",
          "S1 · row 7; no breakdown"
        ]
      ],
      "basis": "S1 supports the balances and arithmetic. It does not explain the receivables or provide comparatives and disclosures.",
      "method": [
        "Confirm year, statement form, principles and language. Inspect sources and preserve each balance's locator.",
        "Propose a reasoned mapping and resolve ambiguous items. Keep decisions awaiting review visible.",
        "Use the current contract and taxonomy for checks and generation. Deliver drafts and diagnostics with their review status, without claiming filing."
      ],
      "result_title": "Balanced totals, unresolved classification",
      "conclusion": "250,000 − 180,000 − 70,000 = EUR 0. Balance does not resolve the nature of other receivables.",
      "output_columns": [
        "Check",
        "Result",
        "Consequence"
      ],
      "output_rows": [
        [
          "Balance-sheet equation",
          "EUR 0 difference",
          "Arithmetic closes"
        ],
        [
          "Other receivables · EUR 8,000",
          "Nature undocumented",
          "Obtain detail before final mapping"
        ],
        [
          "Comparatives and notes",
          "Not supplied in this small case",
          "Incomplete scope"
        ]
      ],
      "check": "Balanced totals do not certify classification, completeness or compliance. Drafts retain their limitations and professional-review requirement.",
      "question": "Can we assign all other receivables to one category just to finish mapping?",
      "answer": "No. The nature of the balance needs supporting detail. Keep the point open and submit the proposal for professional review.",
      "practice": "Add the EUR 8,000 breakdown and reconsider mapping without changing the totals.",
      "next": "Prepare complete balances, comparatives and supporting documents; identify the year and statement form."
    }
  }
