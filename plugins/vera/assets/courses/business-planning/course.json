  "files": [],
  "locales": {
    "it": {
      "title": "Un investimento, due ipotesi da verificare",
      "goal": "Collegare una decisione d'investimento a evidenze commerciali, ipotesi esplicite e risultati di piano.",
      "scenario": "Arco valuta un nuovo servizio in abbonamento. Il caso assume 100 clienti medi a 50 EUR al mese e 42.000 EUR di costi annui. Il prezzo è proposto dal team; la domanda è sostenuta soltanto da cinque colloqui esplorativi.",
      "request": "Vera, aiutami a capire quali ipotesi rendono sostenibile questo nuovo servizio.",
      "scope": "Esempio di piano economico elementare. Ricavi e costi non bastano a stimare cassa, imposte o fabbisogno di investimento.",
      "input_columns": [
        "Ipotesi fittizia",
        "Valore",
        "Fonte"
      ],
      "input_rows": [
        [
          "Clienti medi paganti",
          "100",
          "P1 · ipotesi del team"
        ],
        [
          "Prezzo mensile",
          "50 EUR",
          "P1 · proposta commerciale"
        ],
        [
          "Costi annui",
          "42.000 EUR",
          "P2 · stima operativa"
        ],
        [
          "Interviste esplorative",
          "5",
          "P3 · note; nessun ordine"
        ]
      ],
      "basis": "P1 e P2 sono assunzioni esplicite del caso; P3 esplora bisogni, ma non dimostra 100 clienti acquisiti.",
      "method": [
        "Definisci la decisione e separa evidenze, assunzioni accettate e informazioni ancora da raccogliere.",
        "Costruisci il piano corrente con clienti, prezzi, costi e tempi coerenti. Collega ogni ipotesi alla fonte e mantieni separate le dimensioni economiche e finanziarie.",
        "Confronta scenari utili e presenta la decisione, le sensibilità e le azioni per ridurre l'incertezza. Il professionista rivede il piano e le ipotesi."
      ],
      "result_title": "Il volume di clienti è l'ipotesi decisiva",
      "conclusion": "Nello scenario base i ricavi annui sono 60.000 EUR e il margine sui costi indicati è 18.000 EUR. Con 70 clienti quel margine si azzera.",
      "output_columns": [
        "Scenario",
        "Ricavi annui",
        "Ricavi meno costi indicati"
      ],
      "output_rows": [
        [
          "100 clienti medi",
          "60.000 EUR",
          "18.000 EUR"
        ],
        [
          "70 clienti medi",
          "42.000 EUR",
          "0 EUR"
        ]
      ],
      "check": "Il risultato è condizionato alle ipotesi. Il margine mostrato non è utile netto né cassa; i colloqui non equivalgono a ordini.",
      "question": "Il calcolo è esatto: possiamo confermare la sostenibilità del progetto?",
      "answer": "Possiamo confermare l'aritmetica del caso. Servono evidenze sulla domanda e il piano completo di costi, investimenti e tempi di incasso prima della decisione.",
      "practice": "Portiamo il prezzo a 45 EUR: confrontiamo gli scenari senza nascondere quali ipotesi sono cambiate.",
      "next": "Seleziona un investimento o un'iniziativa concreta e raccogli preventivi, evidenze commerciali e assunzioni che sei pronto a discutere."
    },
    "en": {
