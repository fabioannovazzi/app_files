  "locales": {
    "it": {
      "title": "Estrarre un campione dal giornale contabile",
      "goal": "Imparare a consegnare un giornale, verificare come viene letto e ottenere le righe selezionate per il successivo controllo.",
      "scenario": "Lo studio deve scegliere alcune righe del giornale di Officina Arco da esaminare. Usiamo un piccolo file fittizio per seguire ogni passaggio.",
      "scope": "Prima esecuzione di Journal Sampling: campione casuale di 5 righe, seme 42. La lezione insegna l’uso; il piano di revisione stabilisce metodo e numerosità nel lavoro reale.",
      "inputs": "Apri journal-march.csv e context-it.md. Trova data, registrazione, riga, conto, dare e avere. Il file originale resta conservato nel fascicolo didattico.",
      "request": "Vera, estrai dal giornale di marzo di Officina Arco un campione casuale di 5 righe con seme 42. Prima fammi verificare le colonne e poi mostrami il campione e i controlli sul giornale.",
      "steps": [
        "Vera apre il giornale nella chat di lavoro. La voce ti accompagna nel controllo di colonne, periodo e significato degli importi; Vera registra la mappatura effettivamente rivista.",
        "La procedura prepara il giornale e controlla che le righe e gli importi siano conservati. Se la preparazione non passa, chiarisci il problema prima di selezionare il campione.",
        "Vera esegue il campionamento e apre il risultato Excel. Individua una riga scelta e torna alla stessa riga nel giornale; rivedi insieme dimensione della popolazione, metodo e numero di righe estratte."
      ],
      "deliverables": [
        "Campione in Excel e CSV, con riferimenti alle righe originali.",
        "Giornale preparato, controlli e riepilogo delle scelte per riprodurre l’estrazione."
      ],
      "review": "Verifica che il campione provenga dal periodo e dai conti richiesti e contenga il numero di righe previsto. I controlli di preparazione non certificano le registrazioni o l’adeguatezza del campione. Per controllare i documenti si prosegue con Verifica documentale.",
      "checkpoints": [
        "Prima dell’estrazione, spiega quale popolazione stai campionando.",
        "Sul risultato, ritrova una riga campionata nel file sorgente."
      ],
      "practice": "Ripeti con journal-april.csv, che aggiunge un pagamento di aprile. Mantieni il campione casuale di 5 righe e conserva il primo risultato. Verifica la nuova popolazione e individua una riga del nuovo campione.",
      "success": "Sai preparare la richiesta, trovare il campione e collegare una riga al giornale, senza modificare a mano le righe estratte.",
      "repeat": "Indica a Vera cliente, giornale, periodo ed eventuali filtri, metodo e numerosità previsti dal tuo piano. Chiedi Verifica documentale quando vuoi confrontare il campione con i documenti."
    },
    "en": {
      "title": "Select a sample from an accounting journal",
      "goal": "Learn to provide a journal, check how it is read and obtain selected rows for subsequent examination.",
      "scenario": "The practice needs to select some Officina Arco journal rows for review. A small fictional file lets us follow every step.",
      "scope": "First Journal Sampling run: 5 random rows, seed 42. This teaches operation; the real audit plan determines method and sample size.",
      "inputs": "Open journal-march.csv and context-en.md. Find date, posting, line, account, debit and credit. The original remains preserved in the teaching case.",
      "request": "Vera, select 5 random rows from Officina Arco’s March journal using seed 42. First let me check the columns, then show me the sample and journal preparation checks.",
      "steps": [
        "Vera opens the journal in the working chat. Voice guides you through columns, period and amount meanings; Vera records the mapping actually reviewed.",
        "The workflow prepares the journal and checks that rows and amounts are preserved. If preparation fails, resolve the issue before selecting a sample.",
        "Vera runs the sampling and opens the Excel result. Find one selected row and trace it to the journal; review population size, method and number of sampled rows together."
      ],
      "deliverables": [
        "Excel and CSV sample with references to original rows.",
        "Prepared journal, checks and sampling choices for reproducing the selection."
      ],
      "review": "Check that the sample covers the requested period and accounts and has the expected row count. Preparation checks do not certify postings or sample sufficiency. Continue with Vouching to check supporting documents.",
      "checkpoints": [
        "Before selection, explain which population you are sampling.",
        "In the result, trace a sampled row to the source file."
      ],
      "practice": "Repeat with journal-april.csv, which adds an April payment. Keep the random sample of 5 rows and preserve the first result. Check the new population and identify one row in the new sample.",
      "success": "You can make the request, find the sample and trace a row to the journal without manually replacing selected rows.",
      "repeat": "Tell Vera the client, journal, period, any filters, and the method and size in your audit plan. Ask for Vouching when you want to compare the sample with supporting documents."
    },
    "fr": {
      "title": "Extraire un échantillon du journal comptable",
      "goal": "Apprendre à fournir un journal, vérifier sa lecture et obtenir les lignes sélectionnées pour un contrôle ultérieur.",
      "scenario": "Le cabinet doit sélectionner des lignes du journal d’Officina Arco à examiner. Un petit fichier fictif permet de suivre chaque étape.",
      "scope": "Première exécution de Journal Sampling : 5 lignes aléatoires, graine 42. La leçon enseigne l’utilisation ; le plan d’audit réel détermine méthode et taille.",
      "inputs": "Ouvrez journal-march.csv et context-fr.md. Repérez date, écriture, ligne, compte, débit et crédit. L’original reste conservé dans le dossier pédagogique.",
      "request": "Vera, sélectionne 5 lignes aléatoires du journal de mars d’Officina Arco, avec la graine 42. Fais-moi d’abord vérifier les colonnes, puis montre l’échantillon et les contrôles de préparation.",
      "steps": [
        "Vera ouvre le journal dans la conversation de travail. La voix accompagne la vérification des colonnes, de la période et des montants ; Vera enregistre la correspondance effectivement revue.",
        "La procédure prépare le journal et vérifie la conservation des lignes et montants. Si la préparation échoue, résolvez le problème avant la sélection.",
        "Vera exécute le tirage et ouvre le résultat Excel. Retrouvez une ligne choisie dans le journal ; vérifiez ensemble population, méthode et nombre de lignes sélectionnées."
      ],
      "deliverables": [
        "Échantillon Excel et CSV avec références aux lignes originales.",
        "Journal préparé, contrôles et choix de tirage pour reproduire la sélection."
      ],
      "review": "Vérifiez période, comptes et nombre de lignes attendu. Les contrôles de préparation ne certifient ni les écritures ni la suffisance de l’échantillon. Le Contrôle sur pièces permet ensuite de vérifier les justificatifs.",
      "checkpoints": [
        "Avant le tirage, expliquez quelle population est échantillonnée.",
        "Dans le résultat, retrouvez une ligne sélectionnée dans la source."
      ],
      "practice": "Recommencez avec journal-april.csv, qui ajoute un paiement d’avril. Gardez 5 lignes aléatoires et conservez le premier résultat. Vérifiez la nouvelle population et repérez une ligne du nouvel échantillon.",
      "success": "Vous savez formuler la demande, retrouver l’échantillon et relier une ligne au journal sans remplacer manuellement les lignes tirées.",
      "repeat": "Indiquez client, journal, période, filtres éventuels, méthode et taille prévues par le plan d’audit. Demandez un Contrôle sur pièces pour comparer l’échantillon aux justificatifs."
    },
    "de": {
      "title": "Eine Stichprobe aus dem Buchungsjournal ziehen",
      "goal": "Lernen, ein Journal bereitzustellen, seine Einlesung zu prüfen und ausgewählte Zeilen für die weitere Prüfung zu erhalten.",
      "scenario": "Die Kanzlei möchte Journalzeilen von Officina Arco zur Prüfung auswählen. Eine kleine fiktive Datei macht jeden Schritt nachvollziehbar.",
      "scope": "Erster Einsatz von Journal Sampling: 5 zufällige Zeilen, Startwert 42. Die Lektion erklärt die Bedienung; im echten Auftrag bestimmt der Prüfungsplan Methode und Umfang.",
      "inputs": "Öffnen Sie journal-march.csv und context-de.md. Finden Sie Datum, Buchung, Zeile, Konto, Soll und Haben. Das Original bleibt in der Übungsakte erhalten.",
      "request": "Vera, ziehe aus dem Märzjournal von Officina Arco 5 zufällige Zeilen mit Startwert 42. Lass mich zuerst die Spalten prüfen und zeige anschließend Stichprobe und Aufbereitungskontrollen.",
      "steps": [
        "Vera öffnet das Journal im Arbeitschat. Die Stimme begleitet die Prüfung von Spalten, Zeitraum und Betragsbedeutung; Vera speichert die tatsächlich geprüfte Zuordnung.",
        "Der Ablauf bereitet das Journal auf und prüft die Erhaltung von Zeilen und Beträgen. Klären Sie fehlgeschlagene Aufbereitungskontrollen vor der Stichprobe.",
        "Vera zieht die Stichprobe und öffnet die Excel-Datei. Verfolgen Sie eine ausgewählte Zeile zum Journal zurück und prüfen Sie gemeinsam Grundgesamtheit, Methode und Anzahl der gezogenen Zeilen."
      ],
      "deliverables": [
        "Stichprobe als Excel und CSV mit Verweisen auf Originalzeilen.",
        "Aufbereitetes Journal, Kontrollen und Auswahlparameter zur Wiederholung der Ziehung."
      ],
      "review": "Prüfen Sie Zeitraum, Konten und erwartete Zeilenzahl. Aufbereitungskontrollen bestätigen weder korrekte Buchungen noch einen ausreichenden Stichprobenumfang. Mit der Belegprüfung werden anschließend Belege verglichen.",
      "checkpoints": [
        "Erklären Sie vor der Ziehung die ausgewählte Grundgesamtheit.",
        "Finden Sie eine gezogene Zeile in der Quelldatei wieder."
      ],
      "practice": "Wiederholen Sie mit journal-april.csv, das eine Aprilzahlung ergänzt. Behalten Sie 5 zufällige Zeilen und das erste Ergebnis bei. Prüfen Sie die neue Grundgesamtheit und finden Sie eine Zeile der neuen Stichprobe.",
      "success": "Sie können den Auftrag formulieren, die Stichprobe finden und eine Zeile zum Journal zurückverfolgen, ohne gezogene Zeilen von Hand auszutauschen.",
      "repeat": "Nennen Sie Vera Mandant, Journal, Zeitraum, gegebenenfalls Filter sowie Methode und Umfang aus Ihrem Prüfungsplan. Bitten Sie um Belegprüfung, um die Stichprobe mit Belegen zu vergleichen."
    },
    "es": {
      "title": "Extraer una muestra del diario contable",
      "goal": "Aprender a aportar un diario, comprobar su lectura y obtener líneas seleccionadas para el control posterior.",
      "scenario": "El despacho necesita seleccionar líneas del diario de Officina Arco para examinarlas. Un pequeño archivo ficticio permite seguir todos los pasos.",
      "scope": "Primera ejecución de Journal Sampling: 5 líneas aleatorias, semilla 42. La lección enseña el uso; el plan de auditoría real determina método y tamaño.",
      "inputs": "Abre journal-march.csv y context-es.md. Localiza fecha, asiento, línea, cuenta, debe y haber. El original se conserva en el expediente didáctico.",
      "request": "Vera, extrae 5 líneas aleatorias del diario de marzo de Officina Arco con semilla 42. Primero déjame comprobar las columnas y después muestra la muestra y los controles de preparación.",
      "steps": [
        "Vera abre el diario en la conversación de trabajo. La voz acompaña la revisión de columnas, período y significado de importes; Vera registra la correspondencia realmente revisada.",
        "El flujo prepara el diario y comprueba que conserva líneas e importes. Si falla la preparación, resuelve el problema antes de extraer la muestra.",
        "Vera ejecuta el muestreo y abre el resultado Excel. Encuentra una línea seleccionada en el diario; revisa con la voz población, método y número de líneas extraídas."
      ],
      "deliverables": [
        "Muestra Excel y CSV con referencias a las líneas originales.",
        "Diario preparado, controles y parámetros para reproducir la selección."
      ],
      "review": "Comprueba período, cuentas y número esperado de líneas. Los controles de preparación no certifican los asientos ni la suficiencia de la muestra. La Verificación documental permite después revisar los justificantes.",
      "checkpoints": [
        "Antes de extraer, explica qué población se muestrea.",
        "En el resultado, localiza una línea seleccionada en el archivo fuente."
      ],
      "practice": "Repite con journal-april.csv, que añade un pago de abril. Conserva las 5 líneas aleatorias y el primer resultado. Comprueba la nueva población e identifica una línea de la nueva muestra.",
      "success": "Sabes formular la petición, encontrar la muestra y rastrear una línea al diario sin sustituir manualmente las líneas seleccionadas.",
      "repeat": "Indica a Vera cliente, diario, período, filtros si procede, método y tamaño previstos en tu plan de auditoría. Pide Verificación documental para comparar la muestra con los justificantes."
    }
  }
}
