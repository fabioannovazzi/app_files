{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mparanza.com/schemas/bandi-agevolazioni/review-log-1.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin", "run_id", "events"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "plugin": {"const": "bandi-agevolazioni"},
    "run_id": {"$ref": "#/$defs/id"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "scope", "scope_sha256", "decision", "reviewer_id", "reviewer_role", "confirmation_basis", "identity_assurance", "reviewed_at", "notes"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "scope": {"enum": ["source_baseline", "requirements", "assessments", "dossier"]},
        "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision": {"enum": ["accepted", "returned"]},
        "reviewer_id": {"$ref": "#/$defs/id"},
        "reviewer_role": {"type": "string", "minLength": 1},
        "confirmation_basis": {"const": "explicit_user_confirmation"},
        "identity_assurance": {"const": "asserted_not_authenticated"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}
