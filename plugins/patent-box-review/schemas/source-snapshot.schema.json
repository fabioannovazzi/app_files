{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vera:patent-box:source-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coverage",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "coverage": {
      "type": "string",
      "enum": [
        "COMPLETE_DECLARED_SCOPE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "url",
          "content_sha256",
          "retrieved_at",
          "fetch_status",
          "rule_ids",
          "impact_reviewed",
          "affected_from",
          "affected_to",
          "regime"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "content_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "[a-f0-9]{64}"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "fetch_status": {
            "type": "string",
            "enum": [
              "OK",
              "HTTP_ERROR",
              "TIMEOUT",
              "NOT_FETCHED"
            ]
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "impact_reviewed": {
            "type": "boolean"
          },
          "affected_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "affected_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "regime": {
            "type": "string",
            "enum": [
              "OLD",
              "NEW",
              "TRANSITION",
              "UNKNOWN"
            ]
          }
        }
      },
      "minItems": 0,
      "uniqueItems": false
    }
  }
}
