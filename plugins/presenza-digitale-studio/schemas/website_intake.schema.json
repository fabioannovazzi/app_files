{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mparanza.com/schemas/presenza-digitale-studio/website-intake-v1.json",
  "title": "Website intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "studio",
    "reference_date",
    "objective",
    "audiences",
    "requested_pages",
    "existing_site",
    "selected_files",
    "constraints",
    "external_routes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["refresh", "first_site"]},
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "language"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "jurisdiction": {"type": ["string", "null"]}
      }
    },
    "reference_date": {"type": "string", "format": "date"},
    "objective": {"type": "string", "minLength": 1},
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requested_pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "existing_site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "platform"],
      "properties": {
        "url": {"type": ["string", "null"], "format": "uri"},
        "platform": {"type": ["string", "null"]}
      }
    },
    "selected_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "role": {
            "enum": [
              "current_site_snapshot",
              "screenshot",
              "studio_material",
              "brand_asset",
              "approved_photo",
              "legal_text",
              "source_code",
              "other"
            ]
          },
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "external_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_site_inspection",
        "creative_assistance",
        "preview_publication",
        "final_publication"
      ],
      "properties": {
        "public_site_inspection": {"$ref": "#/$defs/route"},
        "creative_assistance": {"$ref": "#/$defs/route"},
        "preview_publication": {"$ref": "#/$defs/route"},
        "final_publication": {"$ref": "#/$defs/route"}
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "destination", "approved_by_user"],
      "properties": {
        "selected": {"type": "boolean"},
        "destination": {"type": "string"},
        "approved_by_user": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"selected": {"const": true}}},
          "then": {
            "properties": {
              "destination": {"minLength": 1},
              "approved_by_user": {"const": true}
            }
          },
          "else": {"properties": {"approved_by_user": {"const": false}}}
        }
      ]
    }
  }
}
