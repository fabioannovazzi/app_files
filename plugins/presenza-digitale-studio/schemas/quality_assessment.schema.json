{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mparanza.com/schemas/presenza-digitale-studio/quality-assessment-v1.json",
  "title": "Rendered website quality assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_digest",
    "validation_digest",
    "viewports",
    "dimensions",
    "console_issues",
    "weakest_element",
    "verdict",
    "required_changes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "site_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "viewports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width", "height", "full_page_reviewed", "issues"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 280},
          "height": {"type": "integer", "minimum": 400},
          "full_page_reviewed": {"const": true},
          "issues": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hierarchy",
        "copy_clarity",
        "visual_consistency",
        "responsiveness",
        "accessibility_signals",
        "resilience",
        "professional_appropriateness"
      ],
      "properties": {
        "hierarchy": {"$ref": "#/$defs/dimension"},
        "copy_clarity": {"$ref": "#/$defs/dimension"},
        "visual_consistency": {"$ref": "#/$defs/dimension"},
        "responsiveness": {"$ref": "#/$defs/dimension"},
        "accessibility_signals": {"$ref": "#/$defs/dimension"},
        "resilience": {"$ref": "#/$defs/dimension"},
        "professional_appropriateness": {"$ref": "#/$defs/dimension"}
      }
    },
    "console_issues": {"type": "array", "items": {"type": "string"}},
    "weakest_element": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["ready", "revise", "blocked"]},
    "required_changes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["strong", "adequate", "weak", "blocked"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "ready"}}},
      "then": {"properties": {"required_changes": {"maxItems": 0}}},
      "else": {"properties": {"required_changes": {"minItems": 1}}}
    }
  ]
}
