    "dimensions": {
      "factual_accuracy": "Every number, date and population statement is supported by the model context.",
      "evidence_bounding": "Facts, hypotheses, unknowns and limitations remain distinct; no causal or rating claim is invented.",
      "professional_usefulness": "The draft explains what matters to a commercialista beyond restating totals.",
      "prioritization": "Material exceptions, corrections, category changes and coverage gaps are surfaced before minor detail.",
      "uncertainty_discipline": "Missing evidence and alternative explanations are explicit.",
      "actionability": "Questions and next checks are specific, evidence-linked and proportionate."
    }
  },
