{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.1"
      ]
    },
    "pipeline": {
      "enum": [
        "LIPE"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1
    },
    "data_origin": {
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2024,
      "maximum": 2026
    },
    "quarter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "regime": {
      "enum": [
        "MONTHLY",
        "QUARTERLY_OPTION",
        "QUARTERLY_SPECIAL"
      ]
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "scope_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PROPOSED",
            "CONFIRMED"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "reason"
      ]
    },
    "unsupported_features": {
      "type": "array",
