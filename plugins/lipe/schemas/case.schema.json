        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "source_id",
          "path",
          "sha256"
        ]
      }
    },
    "opening": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credit": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
            },
            "small_debit": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "PROPOSED",
                    "CONFIRMED"
                  ]
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed_on": {
                  "type": "string",
                  "format": "date"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reviewer",
                "reviewed_on",
                "reason"
              ]
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
