                    "reviewed_on": {
                      "type": "string",
                      "format": "date"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "reviewer",
                    "reviewed_on",
                    "reason"
                  ]
                },
                "mirror_of": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "row_id",
                "code",
                "base",
                "tax",
                "deductible_tax",
                "base_period",
                "tax_period",
                "deduction_period",
                "evidence",
                "review",
                "mirror_of"
              ]
            }
          }
        },
        "required": [
          "register_id",
          "side",
          "period",
          "number_format",
          "printed_base",
          "printed_tax",
          "evidence",
          "review",
          "rows"
        ]
      }
