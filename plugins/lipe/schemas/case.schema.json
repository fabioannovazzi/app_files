              false
            ]
          },
          "principal_paid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "liquidation_vat": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "PROPOSED",
                  "CONFIRMED"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "page",
              "quote"
            ]
          }
        },
        "required": [
          "period",
          "vp9",
          "vp10",
          "vp11",
          "vp13",
          "vp13_method",
          "credit_withheld",
          "defer_small_debit",
          "principal_paid",
          "liquidation_vat",
          "review",
          "evidence"
        ]
      }
    },
    "liquidations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "number_format": {
            "enum": [
              "it-IT",
              "en-US"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "page",
              "quote"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "PROPOSED",
                  "CONFIRMED"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
