                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source_id",
                    "page",
                    "quote"
                  ]
                },
                "review": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "PROPOSED",
                        "CONFIRMED"
                      ]
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1
