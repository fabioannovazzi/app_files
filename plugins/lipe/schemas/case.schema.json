          "vp9": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp10": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp11": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp13": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "vp13_method": {
            "enum": [
              null,
              1,
              2,
              3,
              4
            ]
          },
          "credit_withheld": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "defer_small_debit": {
            "enum": [
              null,
