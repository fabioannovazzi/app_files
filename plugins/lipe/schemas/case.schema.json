                      "base": {
                        "type": "string",
                        "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                      },
                      "tax": {
                        "type": "string",
                        "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
