              },
              "required": [
                "source_id",
                "page",
                "quote"
              ]
            }
          },
          "required": [
            "credit",
            "small_debit",
            "review",
            "evidence"
          ]
        }
      ]
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "SALES",
              "PURCHASES",
              "INTEGRATION"
            ]
          },
          "treatment": {
            "enum": [
              "SALE_TAXABLE",
              "SALE_NO_OUTPUT_VAT",
              "SALE_EXCLUDED",
              "PURCHASE",
              "PURCHASE_REVERSE_CHARGE",
              "PURCHASE_EXCLUDED",
              "INTEGRATION_MIRROR"
