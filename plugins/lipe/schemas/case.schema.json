            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "row_id": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "base": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                },
                "tax": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                },
                "deductible_tax": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
                },
                "base_period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "tax_period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "deduction_period": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
