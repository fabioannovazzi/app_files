            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
          }
        },
        "required": [
          "code",
          "side",
          "treatment",
          "review"
        ]
      }
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "register_id": {
            "type": "string",
            "minLength": 1
