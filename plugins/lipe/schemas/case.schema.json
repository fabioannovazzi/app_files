          "side": {
            "enum": [
              "SALES",
              "PURCHASES",
              "INTEGRATION"
            ]
          },
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "number_format": {
            "enum": [
              "it-IT",
              "en-US"
            ]
          },
          "printed_base": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "printed_tax": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,10})\\.[0-9]{2}$"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "page",
              "quote"
            ]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "PROPOSED",
                  "CONFIRMED"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_on": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_on",
              "reason"
            ]
