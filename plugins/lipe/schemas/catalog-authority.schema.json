{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "lipe.catalog.authority.v1"},
    "policy_id": {"type": "string", "pattern": "\\S"},
    "catalog_id": {"type": "string", "format": "uuid"},
    "studio_id": {"type": "string", "pattern": "\\S"},
    "data_origin": {"enum": ["REAL", "SYNTHETIC"]},
    "openssl": {"type": "string", "pattern": "\\S"},
    "trusted_roots": {"type": "string", "pattern": "\\S"},
    "crls": {"type": "string", "pattern": "\\S"},
    "revoked_certificate_sha256": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "signers": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "\\S"},
          "certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["PROFESSIONAL", "CURATOR", "DISCLOSURE_REVIEWER"]}
          },
          "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CLIENT", "STUDIO", "CENTRAL"]}},
          "all_clients": {"type": "boolean"},
          "client_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}
        },
        "required": ["name", "certificate_sha256", "roles", "scopes", "all_clients", "client_ids"]
      }
    }
  },
  "required": ["schema_version", "policy_id", "catalog_id", "studio_id", "data_origin", "openssl", "trusted_roots", "crls", "revoked_certificate_sha256", "signers"]
}
