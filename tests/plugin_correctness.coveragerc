[run]
include =
    */plugins/management-control-pack/scripts/management_control_core.py
    */plugins/management-control-pack/scripts/budget_presentation.py
    */plugins/management-control-pack/scripts/management_site.py
    */plugins/management-control-pack/scripts/management_delivery.py
    */plugins/clara/modules/reporting-engine/scripts/budget_report.py
