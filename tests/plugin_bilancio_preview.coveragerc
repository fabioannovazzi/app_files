[run]
include =
    */plugins/bilancio-xbrl-it/scripts/accounts_preview.py
    */plugins/bilancio-xbrl-it/scripts/accounts_preview_text.py
    */plugins/bilancio-xbrl-it/scripts/xbrl_case.py
