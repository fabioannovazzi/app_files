# Deterministic release projections and generated review widgets are committed
# for installation, but they are build artifacts rather than editable source.
plugin_packages/*/claude/** -diff linguist-generated=true
# Actual workflow starter outputs retain their exact hashed bytes, including
# CSV line endings and intentional Markdown hard breaks.
plugins/*/assets/courses/*/files/** -text whitespace=-blank-at-eol
# Authoritative invoice schemas are pinned by their original byte digests.
plugins/invoice-xml/references/xsd/*.xsd -text whitespace=-blank-at-eol,-space-before-tab
plugin_packages/vera/claude/vera/modules/invoice-xml/references/xsd/*.xsd -text whitespace=-blank-at-eol,-space-before-tab
